# Environment Variables for StoreFlow AI Backend
# Application Configuration
APP_NAME=StoreFlow AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security & Authentication
# Note: In production, generate a secure random key using `openssl rand -hex 32`
SECRET_KEY=storeflow_dev_secret_key_super_secure_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_PATH=./webstore.db
DATABASE_URL=sqlite:///./webstore.db

# AI & Gemini API
# Your Google Gemini API Key (obtained from Google AI Studio)
# Backend will safely load this key from environment. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ChromaDB Vector Store
CHROMA_PERSIST_DIRECTORY=./chroma_data
