@startuml
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam roundcorner 10
skinparam state {
    BackgroundColor #F8FAFC
    BorderColor #475569
    FontColor #0F172A
    ArrowColor #2563EB
}

title SƠ ĐỒ TRẠNG THÁI VÒNG ĐỜI ĐƠN HÀNG (ORDER MULTI-STATE WORKFLOW)

[*] --> pending : Khách hàng tạo đơn từ xa\n(Customer Remote Order)\n- Trừ/giữ tồn kho tạm thời\n- Cấp mã đơn hàng

[*] --> completed : Nhân viên bán tại quầy (POS)\n(Staff/Admin Direct POS)\n- Trừ tồn kho nguyên tử\n- Chốt doanh thu ngay lập tức

state pending #FEF3C7 {
    description: "Chờ phê duyệt từ Ban quản trị"
}

state admin_approved #DBEAFE {
    description: "Admin/SuperAdmin đã duyệt\nChờ nhân viên tiếp nhận xử lý"
}

state processing #E0E7FF {
    description: "Nhân viên đang đóng gói / xuất kho"
}

state completed #DCFCE7 {
    description: "Đơn hàng hoàn tất\nDoanh thu được ghi nhận chính thức"
}

state rejected #FEE2E2 {
    description: "Admin/SuperAdmin từ chối duyệt\nHoàn trả tồn kho tự động"
}

state cancelled #F3F4F6 {
    description: "Đơn hàng đã bị hủy\nHoàn trả tồn kho tự động"
}

' Normal Workflow Transitions
pending --> admin_approved : [Admin / SuperAdmin]\nDuyệt đơn (approve)\n- Lưu approved_by, approved_at
pending --> rejected : [Admin / SuperAdmin]\nTừ chối (reject)\n- Lưu rejected_by, rejected_at\n- Bắt buộc nhập rejection_reason\n- Hoàn trả số lượng tồn kho
pending --> cancelled : [Customer]\nTự hủy đơn của mình (Anti-IDOR)\n- Hoàn trả số lượng tồn kho

admin_approved --> processing : [Staff / Admin / SuperAdmin]\nTiếp nhận xử lý (process)\n- Lưu processed_by, processed_at
processing --> completed : [Staff / Admin / SuperAdmin]\nHoàn thành đơn (complete)\n- Chốt payment_status = completed\n- Ghi nhận doanh thu tài chính

' SuperAdmin Exception Actions (Phase 13E)
admin_approved --> cancelled : [SuperAdmin Exception]\nforce_cancel (Bắt buộc lý do)\n- Ghi vết order_audit_logs\n- Hoàn tồn kho
processing --> cancelled : [SuperAdmin Exception]\nforce_cancel (Bắt buộc lý do)\n- Ghi vết order_audit_logs\n- Hoàn tồn kho
completed --> cancelled : [SuperAdmin Exception]\nforce_cancel (Bắt buộc lý do)\n- Ghi vết order_audit_logs\n- Hoàn tồn & điều chỉnh doanh thu

rejected --> pending : [SuperAdmin Exception]\nreopen_rejected (Bắt buộc lý do)\n- Mở lại đơn chờ xét duyệt\n- Ghi vết order_audit_logs

rejected --> [*]
cancelled --> [*]
completed --> [*]

@enduml
