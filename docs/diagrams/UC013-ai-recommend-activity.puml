@startuml
skinparam defaultFontName "Arial"
skinparam shadowing false

start
:Người dùng (Guest / Customer / Staff) mở [Trợ lý AI - Tư vấn Sản phẩm];
:Nhập nhu cầu sản phẩm (ví dụ: "Tai nghe gaming không dây pin lâu");
:Bấm [Gửi câu hỏi];

:Frontend gửi POST /api/v1/ai/recommend;

partition "Lớp Bảo vệ Tần suất & Đầu vào" {
    :RateLimiter kiểm tra giới hạn request theo vai trò;
    if (Vượt quá số request hoặc gửi dồn dập?) then (Vi phạm)
        :Trả lỗi HTTP 429 "Thao tác quá nhanh, vui lòng chờ";
        stop
    endif
    :Kiểm tra độ dài câu hỏi (Guest <= 500 ký tự);
    if (Câu hỏi quá dài?) then (Vượt giới hạn)
        :Trả lỗi HTTP 400 "Độ dài câu hỏi vượt giới hạn";
        stop
    endif
}

partition "Tầng 1: ChromaDB Vector Retrieval" {
    :Trích xuất vector nhúng của câu hỏi (all-MiniLM-L6-v2);
    :Tìm kiếm Top-K sản phẩm tương đồng nhất trong collection storeflow_products;
}

partition "Tầng 2: SQLite Anti-Hallucination Guard" {
    :Truy vấn SQLite Source of Truth theo danh sách Product ID;
    :Lọc chỉ lấy sản phẩm có `status = 'active'` VÀ `stock_quantity > 0`;
    :Lấy giá bán niêm yết chính xác;
    :Ghép dữ liệu sản phẩm thật vào Prompt Context;
}

partition "Tầng 3: Gemini Execution & Graceful Fallback" {
    :Nạp template `product_recommendation.txt`;
    :Gọi Google Gemini Generative Model;
    if (Gemini phản hồi thành công?) then (Thành công)
        :Lấy nội dung câu trả lời tư vấn chi tiết;
        :Đặt cờ `is_fallback = False`;
    else (Lỗi mạng / Timeout / Quota Exceeded)
        :Kích hoạt cơ chế Fallback tự động;
        :Định dạng câu trả lời trực tiếp từ danh sách kho hàng SQLite;
        :Đặt cờ `is_fallback = True`;
    endif
}

partition "Tầng 4: Bộ lọc Bí mật & Kiểm toán" {
    :OutputSecretSanitizer quét và che giấu API Key / Passwords;
    :Ghi nhật ký tương tác vào bảng `ai_audit_logs`;
}

:Backend trả về JSON kết quả kèm danh sách sản phẩm đối soát;
if (is_fallback == True?) then (Chế độ dự phòng)
    :Frontend hiển thị thông báo "Chế độ tra cứu trực tiếp từ kho hàng";
else (Bình thường)
    :Frontend hiển thị câu trả lời tư vấn từ Trợ lý AI;
endif
:Hiển thị danh sách Thẻ Sản phẩm Tương tác từ SQLite:
- Customer: Nút [Thêm vào giỏ hàng]
- Staff: Nút [Mở POS bán hàng];
stop
@enduml