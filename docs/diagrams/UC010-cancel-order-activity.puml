@startuml
skinparam defaultFontName "Arial"
skinparam shadowing false

start
:Người dùng (Customer / Admin / SuperAdmin) chọn thao tác hủy đơn;

if (Tác nhân là Customer?) then (Đúng)
    :Customer bấm [Hủy đơn của tôi] tại đơn 'pending';
    :Frontend gửi POST /api/v1/orders/{id}/customer-cancel;
    :Backend kiểm tra quyền sở hữu đơn hàng (Anti-IDOR);
    if (Đơn thuộc về Customer & status == 'pending'?) then (Hợp lệ)
        :Chuyển trạng thái sang 'cancelled';
    else (Không hợp lệ)
        :Trả lỗi HTTP 400/403 (Chỉ được hủy đơn pending của chính mình);
        stop
    endif
else (Admin / SuperAdmin)
    if (Thao tác là Từ chối duyệt (Reject)?) then (Reject)
        :Admin/SuperAdmin nhập lý do từ chối (rejection_reason);
        :Frontend gửi POST /api/v1/orders/{id}/reject;
        :Chuyển trạng thái sang 'rejected';
        :Lưu rejected_by, rejected_at, rejection_reason;
    else (Cancel thông thường hoặc SuperAdmin Force Action)
        :Frontend gửi POST /api/v1/orders/{id}/cancel hoặc force-action;
        :Chuyển trạng thái sang 'cancelled';
        if (Là SuperAdmin force_cancel?) then (Có)
            :Ghi vết kiểm toán vào order_audit_logs;
        endif
    endif
endif

partition "Hoàn trả tồn kho nguyên tử (BEGIN IMMEDIATE)" {
    :Khóa giao dịch cơ sở dữ liệu SQLite;
    :Lấy danh sách các mặt hàng từ `order_items`;
    while (Còn mặt hàng trong order_items?) is (Có)
        :UPDATE products SET stock_quantity = stock_quantity + item.quantity WHERE id = item.product_id;
        :INSERT INTO inventory_logs (change_type='return_cancel', reference_code=order_code, ...);
    endwhile (Hết danh sách)
    :Thực thi `COMMIT`;
}

:Backend trả về HTTP 200 kèm đơn hàng đã hủy;
:Frontend cập nhật trạng thái đơn và giao diện;
stop
@enduml