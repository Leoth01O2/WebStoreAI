@startuml
skinparam defaultFontName "Arial"
skinparam shadowing false

actor "Người dùng (Các vai trò)" as User
boundary "AiAssistantPage" as UI
control "AiRouter (/api/v1/ai/sales-qa)" as Router
control "AiService (RBAC Enforcer)" as AI
entity "SQLite DB (`orders`)" as DB
control "Google Gemini API" as Gemini

User -> UI: Gửi câu hỏi "Doanh thu tháng này là bao nhiêu?"
UI -> Router: POST /api/v1/ai/sales-qa\n{query: "...", token: user_token}
Router -> AI: answer_sales_qa(query, current_user)

AI -> AI: Phát hiện ý định: REVENUE_FINANCIAL_INTENT
alt Người dùng là Guest / Customer / Staff / Admin
    AI --> Router: "Xin lỗi, thông tin doanh thu cửa hàng thuộc phạm vi bảo mật của Chủ cửa hàng (SuperAdmin)."
    Router --> UI: HTTP 200 OK (Thông báo từ chối phân quyền an toàn)
    UI --> User: Hiển thị cảnh báo phân quyền
else Người dùng là SuperAdmin
    AI -> DB: Truy vấn số liệu doanh thu tháng này
    DB --> AI: Tổng doanh thu, số đơn hoàn tất
    AI -> Gemini: generate_content(prompt_with_financial_facts)
    Gemini --> AI: Phân tích số liệu chính xác
    AI --> Router: Câu trả lời chi tiết
    Router --> UI: HTTP 200 OK (Response text)
    UI --> User: Hiển thị phân tích doanh thu
end
@enduml