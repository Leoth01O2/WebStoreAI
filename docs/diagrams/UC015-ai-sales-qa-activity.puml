@startuml
skinparam defaultFontName "Arial"
skinparam shadowing false

start
:Người dùng gửi câu hỏi qua Trợ lý AI (POST /api/v1/ai/sales-qa);
:Backend kiểm tra Rate Limit & Cooldown;

partition "1. Phòng thủ Prompt Injection" {
    if (Phát hiện câu lệnh cố tình bypass / chiếm quyền?) then (Có)
        :Từ chối xử lý: "Tôi là Trợ lý StoreFlow AI, không thể thực hiện yêu cầu này";
        stop
    endif
}

partition "2. Phân loại Ý định & Enforce Phân quyền RBAC" {
    :Phân tích ý định câu hỏi (Doanh thu / Tài chính hay Nghiệp vụ);
    if (Câu hỏi về Doanh thu / Lợi nhuận?) then (Có)
        if (Vai trò của người hỏi là SuperAdmin?) then (SuperAdmin)
            :Truy vấn số liệu doanh thu thực tế từ SQLite;
            :Nạp số liệu vào Prompt Context;
            :Gọi Gemini phân tích và trả lời;
            stop
        else (Guest / Customer / Staff / Admin)
            :Từ chối trả lời: "Thông tin doanh thu thuộc quyền bảo mật của Chủ cửa hàng";
            stop
        endif
    else (Câu hỏi thông thường / Vận hành)
        :Tra cứu tài liệu hướng dẫn và sản phẩm;
        :Gọi Gemini / Fallback trả lời;
        stop
    endif
}
@enduml