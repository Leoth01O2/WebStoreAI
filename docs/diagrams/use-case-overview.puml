@startuml
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Be Vietnam Pro, Arial, sans-serif"
skinparam roundCorner 8
skinparam arrowColor #4A5568
skinparam actorBorderColor #2D3748
skinparam usecaseBorderColor #4A5568
skinparam usecaseBackgroundColor #F7FAFC

' ==============================================================================
' STOREFLOW AI 2.0 — USE CASE DIAGRAM TỔNG THỂ (LATEST ARCHITECTURE)
' Mô hình phân quyền RBAC 5 vai trò & Quy trình AI/POS/Workflow thực tế
' ==============================================================================

' --- ACTORS & KẾ THỪA PHÂN QUYỀN ---
actor "Khách vãng lai\n(Guest)" as Guest #EDF2F7
actor "Khách hàng\n(Customer)" as Customer #BEE3F8
actor "Nhân viên quầy / kho\n(Staff)" as Staff #C6F6D5
actor "Quản trị viên kỹ thuật\n(Admin)" as Admin #FEEBC8
actor "Chủ cửa hàng\n(SuperAdmin)" as SuperAdmin #FED7D7

Guest <|-- Customer
Staff <|-- Admin
Admin <|-- SuperAdmin

rectangle "STOREFLOW AI 2.0 — HỆ THỐNG QUẢN LÝ BÁN HÀNG TÍCH HỢP AI" {

    ' --- 1.0 XÁC THỰC & PHÂN QUYỀN ---
    package "1.0 Xác thực & Phân quyền (Auth & RBAC)" {
        usecase "UC001: Đăng ký & Đăng nhập (JWT HS256)" as UC001
        usecase "UC002: Xem & Cập nhật Hồ sơ cá nhân" as UC002
        usecase "UC003: Quản lý Tài khoản & Trạng thái người dùng" as UC003
    }

    ' --- 2.0 QUẢN LÝ DANH MỤC & SẢN PHẨM ---
    package "2.0 Quản lý Danh mục & Sản phẩm (Catalog Management)" {
        usecase "UC004: Duyệt Storefront công khai & Chi tiết sản phẩm" as UC004
        usecase "UC005: Quản lý Danh mục sản phẩm (CRUD Category)" as UC005
        usecase "UC006: Quản lý Sản phẩm & Upload ảnh (Ẩn giá vốn cost_price)" as UC006
    }

    ' --- 3.0 QUẢN LÝ KHÁCH HÀNG & BẢO MẬT PII ---
    package "3.0 Quản lý Khách hàng & Bảo mật PII (Customer CRM)" {
        usecase "UC007: Tra cứu Khách hàng tại quầy (PII Data Masking)" as UC007
        usecase "UC008: Xem Hồ sơ khách hàng cá nhân" as UC008
        usecase "UC009: Quản lý & Xóa Khách hàng (Xem đầy đủ PII)" as UC009
    }

    ' --- 4.0 BÁN HÀNG TẠI QUẦY & VẬN HÀNH ĐƠN HÀNG ---
    package "4.0 Bán hàng POS & Luồng Đơn hàng (Order Workflow)" {
        usecase "UC010: Bán hàng tại quầy POS & Trừ kho tức thì" as UC010
        usecase "UC011: Đặt hàng trực tuyến & Theo dõi Đơn cá nhân" as UC011
        usecase "UC012: Tiếp nhận đơn, Xác nhận COD & Cập nhật Vận chuyển" as UC012
        usecase "UC013: Phê duyệt, Xác minh Chuyển khoản & Xử lý Ngoại lệ" as UC013
        usecase "UC014: Hủy đơn, Xác nhận Hoàn tiền & Hoàn kho tự động" as UC014
        usecase "UC015: Xem Nhật ký Kiểm toán Đơn hàng (Order Audit Logs)" as UC015
    }

    ' --- 5.0 NHẬP HÀNG & QUẢN LÝ TỒN KHO ---
    package "5.0 Nhập hàng & Quản lý Kho vận (Inventory & Purchasing)" {
        usecase "UC016: Lập Đơn nhập hàng & Tăng tồn kho (Purchases)" as UC016
        usecase "UC017: Theo dõi Sổ kho & Cảnh báo Sắp hết hàng (Low-stock)" as UC017
    }

    ' --- 6.0 BÁO CÁO DOANH THU & PHÂN TÍCH TÀI CHÍNH ---
    package "6.0 Báo cáo Doanh thu & Phân tích BI (SuperAdmin Only)" {
        usecase "UC018: Xem Dashboard Tổng quan Doanh thu & Top Sản phẩm" as UC018
        usecase "UC019: Xuất Báo cáo Đơn hàng & Tài chính ra CSV / Excel" as UC019
    }

    ' --- 7.0 TRỢ LÝ AI ĐA PHƯƠNG THỨC & RAG ---
    package "7.0 Trợ lý AI Đa phương thức & RAG (Multimodal AI)" {
        usecase "UC020: AI Tư vấn Sản phẩm RAG (Chốt chặn SQLite Truth Guard)" as UC020
        usecase "UC021: Tìm kiếm Sản phẩm bằng Hình ảnh (Local CLIP ViT-B/32 & Gemini)" as UC021
        usecase "UC022: AI Hỏi đáp Nghiệp vụ theo Role & Tra cứu Đơn (Anti-IDOR)" as UC022
        usecase "UC023: AI Phân tích & Sinh Báo cáo Doanh thu (AI BI Sales Report)" as UC023
    }

    ' --- 8.0 QUẢN TRỊ CHỈ MỤC VECTOR & AN TOÀN AI ---
    package "8.0 Quản trị An toàn AI & ChromaDB (AI Governance)" {
        usecase "UC024: Giám sát AI Providers & Tự phục hồi Chỉ mục Vector (3 Collections)" as UC024
        usecase "UC025: Xem Nhật ký Kiểm toán AI (AI Audit Logs)" as UC025
    }
}

' ==============================================================================
' LIÊN KẾT TÁC NHÂN (ACTORS) -> USE CASES (ĐỒNG BỘ MŨI TÊN CHUẨN UML)
' ==============================================================================

' --- GUEST ---
Guest --> UC001
Guest --> UC004
Guest --> UC020
Guest --> UC021
Guest --> UC022

' --- CUSTOMER (Kế thừa Guest) ---
Customer --> UC002
Customer --> UC008
Customer --> UC011
Customer --> UC014

' --- STAFF ---
Staff --> UC002
Staff --> UC007
Staff --> UC010
Staff --> UC012
Staff --> UC014
Staff --> UC015
Staff --> UC017
Staff --> UC022

' --- ADMIN (Kế thừa Staff) ---
Admin --> UC003
Admin --> UC024
Admin --> UC025

' --- SUPERADMIN (Kế thừa Admin) ---
SuperAdmin --> UC005
SuperAdmin --> UC006
SuperAdmin --> UC009
SuperAdmin --> UC013
SuperAdmin --> UC014
SuperAdmin --> UC016
SuperAdmin --> UC017
SuperAdmin --> UC018
SuperAdmin --> UC019
SuperAdmin --> UC023

@enduml
