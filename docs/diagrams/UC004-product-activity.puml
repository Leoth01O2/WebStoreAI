@startuml
skinparam defaultFontName "Arial"
skinparam shadowing false

start
:Quản trị viên / Nhân viên mở trang Quản lý Sản phẩm;
:Chọn [Thêm sản phẩm mới] hoặc [Chỉnh sửa];
:Nhập thông tin: Tên, SKU, Danh mục, Giá vốn, Giá bán, Tồn kho;

if (Có chọn file ảnh tải lên?) then (Có)
    :Gửi POST /api/v1/products/upload-image (Multipart);
    :Backend kiểm tra định dạng file (PNG, JPG, WEBP);
    :Lưu file vào thư mục `backend/uploads/products/`;
    :Trả về đường dẫn tĩnh `/uploads/products/{filename}`;
else (Không)
    :Sử dụng ảnh mặc định của hệ thống;
endif

:Gửi POST /api/v1/products hoặc PUT /api/v1/products/{id};
:Backend kiểm tra quyền vai trò (Admin / SuperAdmin / Staff);
:Kiểm tra tính duy nhất của mã SKU trong CSDL;

if (SKU bị trùng lặp?) then (Có)
    :Trả lỗi HTTP 400 "Mã SKU đã tồn tại";
    :Hiển thị thông báo lỗi trên Form;
    stop
else (SKU hợp lệ)
    :Thực thi INSERT / UPDATE vào bảng `products`;
    :Kích hoạt cập nhật dữ liệu vector vào ChromaDB;
    :Backend trả HTTP 200 / 201 Thành công;
    :Frontend cập nhật danh sách sản phẩm;
    stop
endif
@enduml