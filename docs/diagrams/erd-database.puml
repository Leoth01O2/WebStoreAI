@startuml
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam roundcorner 6

title SƠ ĐỒ THỰC THỂ LIÊN KẾT (DATABASE ERD - 12 BẢNG SQLITE)

entity "users" as users #E0F2FE {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    * username : TEXT <<UNIQUE>>
    * password_hash : TEXT
    * full_name : TEXT
    * role : TEXT <<CHECK: superadmin, admin, staff, customer>>
    * is_active : INTEGER <<DEFAULT 1>>
    created_at : TIMESTAMP
}

entity "categories" as categories #FEF3C7 {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    * name : TEXT
    * code : TEXT <<UNIQUE>>
    created_at : TIMESTAMP
}

entity "products" as products #FEF3C7 {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    * sku : TEXT <<UNIQUE>>
    * name : TEXT
    category_id : INTEGER <<FK>>
    * cost_price : REAL <<DEFAULT 0>>
    * selling_price : REAL <<DEFAULT 0>>
    * stock_quantity : INTEGER <<DEFAULT 0>>
    * min_stock_alert : INTEGER <<DEFAULT 5>>
    * unit : TEXT <<DEFAULT 'cái'>>
    * status : TEXT <<CHECK: active, inactive>>
    image_url : TEXT
    description : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity "product_visual_metadata" as visual_meta #F3E8FF {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    * product_id : INTEGER <<FK, UNIQUE>>
    * image_path : TEXT
    * product_type : TEXT
    dominant_color : TEXT
    shape_form : TEXT
    material : TEXT
    visible_features : TEXT
    visual_description : TEXT
    search_keywords : TEXT
    visual_embedding : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity "customers" as customers #ECFDF5 {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    * customer_code : TEXT <<UNIQUE>>
    * name : TEXT
    phone : TEXT
    email : TEXT
    address : TEXT
    * group_name : TEXT <<CHECK: retail, vip, wholesale>>
    * total_spent : REAL <<DEFAULT 0>>
    created_at : TIMESTAMP
}

entity "orders" as orders #DCFCE7 {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    * order_code : TEXT <<UNIQUE>>
    customer_id : INTEGER <<FK>>
    user_id : INTEGER <<FK>>
    * total_amount : REAL <<DEFAULT 0>>
    * discount_amount : REAL <<DEFAULT 0>>
    * final_amount : REAL <<DEFAULT 0>>
    * payment_method : TEXT <<CHECK: cash, transfer, card>>
    * payment_status : TEXT <<CHECK: pending, paid, completed>>
    * status : TEXT <<CHECK: pending, admin_approved, processing, completed, rejected, cancelled>>
    note : TEXT
    approved_by : INTEGER <<FK>>
    approved_at : TIMESTAMP
    processed_by : INTEGER <<FK>>
    processed_at : TIMESTAMP
    rejected_by : INTEGER <<FK>>
    rejected_at : TIMESTAMP
    rejection_reason : TEXT
    created_at : TIMESTAMP
}

entity "order_items" as order_items #DCFCE7 {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    * order_id : INTEGER <<FK>>
    * product_id : INTEGER <<FK>>
    * quantity : INTEGER
    * unit_price : REAL
    * total_price : REAL
}

entity "order_audit_logs" as order_audit #FFE4E6 {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    * order_id : INTEGER <<FK>>
    * action : TEXT
    * previous_status : TEXT
    * resulting_status : TEXT
    performed_by : INTEGER <<FK>>
    * reason : TEXT
    created_at : TIMESTAMP
}

entity "purchase_receipts" as purchases #FFF7ED {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    * receipt_code : TEXT <<UNIQUE>>
    * supplier_name : TEXT
    * total_amount : REAL
    note : TEXT
    created_by : INTEGER <<FK>>
    created_at : TIMESTAMP
}

entity "purchase_items" as purchase_items #FFF7ED {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    * receipt_id : INTEGER <<FK>>
    * product_id : INTEGER <<FK>>
    * quantity : INTEGER
    * unit_cost : REAL
    * total_cost : REAL
}

entity "inventory_logs" as inventory_logs #F1F5F9 {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    * product_id : INTEGER <<FK>>
    * change_type : TEXT <<CHECK: import, sale, return_cancel, adjustment>>
    reference_code : TEXT
    * quantity_before : INTEGER
    * change_quantity : INTEGER
    * quantity_after : INTEGER
    note : TEXT
    created_at : TIMESTAMP
}

entity "ai_audit_logs" as ai_logs #F8FAFC {
    * id : INTEGER <<PK, AUTOINCREMENT>>
    --
    user_id : INTEGER <<FK>>
    * feature : TEXT <<CHECK: recommendation, sales_report, sales_qa>>
    * query_text : TEXT
    response_summary : TEXT
    latency_ms : INTEGER
    created_at : TIMESTAMP
}

' Relationships
categories ||..o{ products : "1:N (phân loại)"
products ||--o| visual_meta : "1:1 (đặc trưng thị giác)"

products ||..o{ order_items : "1:N"
orders ||--|{ order_items : "1:N (chi tiết đơn)"

customers ||..o{ orders : "1:N (đặt hàng)"
users ||..o{ orders : "1:N (tạo/phụ trách)"
users ||..o{ orders : "1:N (duyệt approved_by)"
users ||..o{ orders : "1:N (xử lý processed_by)"
users ||..o{ orders : "1:N (từ chối rejected_by)"

orders ||--o{ order_audit : "1:N (nhật ký ngoại lệ)"
users ||..o{ order_audit : "1:N (người can thiệp)"

products ||..o{ purchase_items : "1:N"
purchases ||--|{ purchase_items : "1:N (chi tiết nhập)"
users ||..o{ purchases : "1:N (người tạo phiếu)"

products ||..o{ inventory_logs : "1:N (nhật ký kho)"
users ||..o{ ai_logs : "1:N (người truy vấn AI)"

@enduml
