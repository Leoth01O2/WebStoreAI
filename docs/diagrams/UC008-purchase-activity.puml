@startuml
skinparam defaultFontName "Arial"
skinparam shadowing false

start
:Admin / SuperAdmin / Staff mở trang Nhập hàng;
:Nhập tên Nhà cung cấp và ghi chú đơn nhập;
:Chọn danh sách sản phẩm, nhập số lượng và đơn giá vốn;
:Bấm [LẬP PHIẾU NHẬP HÀNG];

:Frontend gửi POST /api/v1/purchases;
:Backend kiểm tra quyền vai trò (Admin / SuperAdmin / Staff);

if (Hợp lệ?) then (Có)
    :Mở giao dịch SQLite nguyên tử `BEGIN IMMEDIATE`;
    :INSERT INTO purchase_receipts (receipt_code, supplier_name, total_amount, created_by);
    while (Còn mặt hàng nhập?) is (Có)
        :INSERT INTO purchase_items (receipt_id, product_id, quantity, unit_cost, total_cost);
        :UPDATE products SET stock_quantity = stock_quantity + item.quantity WHERE id = ?;
        :INSERT INTO inventory_logs (change_type='import', product_id, change_quantity, ...);
    endwhile (Hết mặt hàng)
    :Thực thi `COMMIT`;
    :Backend trả về HTTP 201 Created kèm chi tiết phiếu nhập;
    :Frontend cập nhật tồn kho mới trên giao diện;
    stop
else (Không đủ quyền)
    :Trả HTTP 403 Forbidden;
    stop
endif
@enduml